{
  "name": "ibaraki-dev-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "sync:events": "node scripts/sync-events.mjs",
    "deploy": "npm run build && wrangler deploy",
    "check:worker": "wrangler types && tsc -p tsconfig.worker.json",
    "dev:worker": "npm run build && wrangler dev --test-scheduled",
    "reports:withdraw": "node scripts/report-admin.mjs withdraw",
    "reports:restore": "node scripts/report-admin.mjs restore",
    "reports:status": "node scripts/report-admin.mjs status"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@lucide/astro": "^1.58.0",
    "astro": "^7.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.186.0",
    "node": "^24.22.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  },
  "overrides": {}
}
