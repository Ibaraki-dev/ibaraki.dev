---
import {renderEventCard} from '../../scripts/event-card.mjs';
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import data from '../data/events.json';
import {materials,community} from '../data/community';
const years=[...new Set(data.events.map(e=>e.startsAt.slice(0,4)))];
---
<Layout description="ibaraki.dev のイベント開催履歴と公開資料。茨城・水戸で開催するもくもく会、LT・テックトークの情報を紹介します。" title="イベントアーカイブ"><section class="wrap page-intro"><p class="eyebrow">MEETUP ARCHIVE</p><h1>イベント</h1><p>開催情報と公開資料。</p></section><section class="wrap archive-section"><div class="archive-report-link"><a class="text-link" href="/reports/">開催レポート <Icon name="arrow"/></a></div><div class="filters"><label><span class="filter-title"><Icon name="search"/>キーワード</span><input type="search" id="search" placeholder="イベント名・会場で探す"/></label><label><span class="filter-title"><Icon name="calendar"/>開催年</span><select id="year"><option value="all">すべての年</option>{years.map(y=><option value={y}>{y}年</option>)}</select></label></div><p class="archive-note" id="result-count" aria-live="polite">{data.events.length}件の開催情報</p><div id="event-list" class="event-grid" set:html={data.events.map(e=>renderEventCard(e)).join('')}/><p class="no-results" id="no-results" hidden>該当するイベントはありません。キーワードや開催年を変えてみてください。</p><p class="archive-note">connpass の開催情報を掲載しています。開催レポートは、会の終了後に順次公開します。</p><a class="text-link" href={`${community.connpass}event/`}>すべての開催履歴を connpass で見る <Icon name="external"/></a><section class="materials"><h2><Icon name="document"/>公開資料</h2>{materials.map(m=><a href={m.url}><span class="material-title">{m.title}<Icon name="external"/></span><small>{m.date} · #{m.number}</small></a>)}</section></section></Layout>
<script>
const search=document.querySelector<HTMLInputElement>('#search')!;const year=document.querySelector<HTMLSelectElement>('#year')!;const rows=[...document.querySelectorAll<HTMLElement>('.event-card')];
function filter(){let count=0;for(const row of rows){const match=(year.value==='all'||row.dataset.year===year.value)&&row.dataset.search!.toLowerCase().includes(search.value.trim().toLowerCase());row.hidden=!match;if(match)count++;}document.querySelector('#result-count')!.textContent=`${count}件の開催情報`;document.querySelector<HTMLElement>('#no-results')!.hidden=count>0;}
document.querySelectorAll<HTMLImageElement>('[data-event-thumbnail]').forEach(img=>{const fallback=()=>{if(!img.src.endsWith('/logo.svg'))img.src='/logo.svg';};img.addEventListener('error',fallback,{once:true});if(img.complete&&!img.naturalWidth)fallback();});
search.addEventListener('input',filter);year.addEventListener('change',filter);
</script>
